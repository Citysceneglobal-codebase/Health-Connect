# ============================================================================
# HEALTH-CONNECT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.development or .env.production as needed
# DO NOT commit actual secrets - use secure secret management
# ============================================================================

# === CORE APPLICATION CONFIGURATION ===
NODE_ENV=development
PORT=5007

# === DATABASE CONFIGURATION ===
# Using SQLite for simplicity and single-instance deployments
# Database file stored at ./sqlite.db (in Docker: /app/sqlite.db)
# No DATABASE_URL needed - defaults to SQLite
DATABASE_URL=

# === SESSION MANAGEMENT ===
# Required: Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters-long

# === AUTHENTICATION (OpenID Connect) ===
# Production: Must be configured for Passport.js OpenID Connect flow
# Development: Can be left empty - mock auth will be used
ISSUER_URL=https://your-oauth-provider.com/oidc
CLIENT_ID=your-oauth-client-id
CLIENT_SECRET=your-oauth-client-secret
REDIRECT_URI=http://localhost:5007/api/callback
REPL_ID=          # Only if hosting on Replit

# === FRONTEND CONFIGURATION ===
# URL of your frontend application (for CORS)
FRONTEND_URL=http://localhost:5173

# Vite build-time configuration
# Set to your production API URL
VITE_API_URL=http://localhost:5007

# NOTES
# ============================================================================
# Database: Uses SQLite (single instance only, sessions in memory)
# Sessions: In-memory store (lost on restart, not suitable for multi-instance)
# For multi-instance production: Migrate to PostgreSQL + external session store
#
# ============================================================================
# ============================================================================
# OPTIONAL INTEGRATIONS (Currently Unused - Keep Commented)
# ============================================================================

# === PAYMENT GATEWAY ===
# Uncomment and configure when ready to implement payments
# STRIPE_SECRET_KEY=sk_test_your_stripe_key_here
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key_here
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# PAYMENT_CURRENCY=INR
# PAYMENT_SUCCESS_URL=https://yourdomain.com/payments/success
# PAYMENT_CANCEL_URL=https://yourdomain.com/payments/cancel

# === NOTIFICATION SERVICES ===
# Uncomment and configure when ready to implement notifications

# SMS via Twilio
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# Email via SendGrid
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=Health Connect

# Push Notifications via Firebase
# FIREBASE_SERVER_KEY=your_firebase_server_key
# FIREBASE_PROJECT_ID=your-firebase-project-id

# === WEARABLE DEVICE INTEGRATIONS ===
# Uncomment and configure when ready to implement wearable sync

# Fitbit Integration
# FITBIT_CLIENT_ID=your_fitbit_client_id
# FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# Google Fit Integration
# GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id
# GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret

# Apple Health Integration
# APPLE_HEALTH_KEY_ID=your_apple_key_id
# APPLE_HEALTH_TEAM_ID=your_apple_team_id
# APPLE_HEALTH_BUNDLE_ID=com.example.healthconnect

# ============================================================================
# MONITORING & LOGGING (Optional)
# ============================================================================
# LOG_LEVEL=info
# PROMETHEUS_ENABLED=false
# GRAFANA_PASSWORD=admin_password_here

# ============================================================================
# DEVELOPMENT-SPECIFIC
# ============================================================================
# Uncomment for verbose logging in development
# DEBUG=*
